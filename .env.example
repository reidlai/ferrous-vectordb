# ==============================================================================
# FerrousCX ferrous-vectordb Environment Configuration Blueprint
# DevSecOps Secret Zero: Never commit actual credentials to version control.
# Copy this template to .env and configure local runtime values.
# ==============================================================================

# Qdrant Network & Service Configuration
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333

# Storage Persistence Mounts
QDRANT_STORAGE_PATH=/qdrant/storage
QDRANT_SNAPSHOTS_PATH=/qdrant/snapshots

# Telemetry & Logging
QDRANT_TELEMETRY_DISABLED=true
QDRANT_LOG_LEVEL=INFO

# Security & Authentication (Masked Blueprint)
# In production or secured clusters, set a high-entropy bearer token API key.
# Leave commented or empty for unsecured local development.
# QDRANT__SERVICE__API_KEY=********-****-****-****-************
